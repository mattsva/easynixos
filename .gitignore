# Nix build outputs
result
result-*
.direnv/

# Machine-local configuration backups
*.nix.bak
*.nix.bak_*
*.bak
*.bak_*

# Local secrets and environment files
.env
.env.*
vars.local.nix
!.env.example
secrets/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*~

# Note: vars.nix and hardware-configuration.nix are NOT gitignored.
# Nix flakes require all imported paths to be tracked by Git.
# vars.nix is the committed example template (fallback if vars.local.nix absent).
# hardware-configuration.nix must exist and be tracked for flake evaluation.
# Personal overrides go in vars.local.nix (git-ignored above).
