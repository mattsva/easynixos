// Fastfetch Custom Configuration
// mattsva's Noctalia-themed NixOS desktop
// Dark purple theme derived from Noctalia wallpaper palette
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "nixos",
    "type": "auto"
  },

  "separator": {
    "character": ": ",
    "color": {
      "text": "#b4befe"
    }
  },

  "title": {
    "title": "Fastfetch"
  },

  "key": {
    "width": 18,
    "color": {
      "names": "blue"
    }
  },

  "values": {
    "color": {
      "names": "default"
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "terminalfont",
    {
      "type": "cpu",
      "showPeCoreCount": true
    },
    "gpu",
    {
      "type": "memory",
      "percent": {
        "type": 3
      }
    },
    "swap",
    "disk",
    "battery",
    "break",
    "media",
    "colors"
  ],

  "colors": {
    "logo": "#b4befe",
    "separator": "#6c7086"
  }
}
